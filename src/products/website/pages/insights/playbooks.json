[
  {
    "id": "decision-review",
    "category": "Clarity",
    "title": "Make decisions with clear ownership",
    "description": "Track pending decisions, understand the cost of waiting, and keep reviews visible.",
    "tools": [
      {
        "id": "T19",
        "code": "Q02",
        "name": "Decision Register",
        "purpose": "Keeps a record of decisions and measures cycle time, stalled and recurring decisions, missing owners and overdue reviews.",
        "computes": "Decision cycle time, stalled and recurring decisions, missing owners and rationale, overdue reviews and reversal rate.",
        "limits": "Built from the decisions you record; it does not judge whether a decision was right.",
        "spec": {
          "kind": "schema",
          "fields": [
            {
              "key": "asOf",
              "label": "As of (defaults to today)",
              "type": "date"
            },
            {
              "key": "stallDays",
              "label": "Treat an open decision as stalled after (days)",
              "type": "integer",
              "min": 1,
              "default": 30
            }
          ],
          "tables": [
            {
              "key": "decisions",
              "label": "Decisions",
              "minRows": 1,
              "columns": [
                {
                  "key": "title",
                  "label": "Decision",
                  "type": "text",
                  "required": true
                },
                {
                  "key": "owner",
                  "label": "Owner",
                  "type": "text"
                },
                {
                  "key": "raised",
                  "label": "Raised on",
                  "type": "date",
                  "required": true
                },
                {
                  "key": "decided",
                  "label": "Decided on",
                  "type": "date"
                },
                {
                  "key": "status",
                  "label": "Status",
                  "type": "select",
                  "options": [
                    {
                      "value": "open",
                      "label": "open"
                    },
                    {
                      "value": "decided",
                      "label": "decided"
                    },
                    {
                      "value": "implemented",
                      "label": "implemented"
                    },
                    {
                      "value": "reversed",
                      "label": "reversed"
                    }
                  ],
                  "required": true
                },
                {
                  "key": "topic",
                  "label": "Topic tag (same tag = same recurring question)",
                  "type": "text"
                },
                {
                  "key": "rationale",
                  "label": "Rationale recorded",
                  "type": "boolean"
                },
                {
                  "key": "reviewBy",
                  "label": "Review by",
                  "type": "date"
                }
              ]
            }
          ]
        }
      },
      {
        "id": "T23",
        "code": "Q05",
        "name": "Decision Timing & Cost of Delay",
        "purpose": "Orders pending decisions by the cost of waiting and flags deadlines that can no longer be met.",
        "computes": "Orders pending items by cost of delay divided by duration (WSJF), places them on the Eisenhower matrix, and flags deadlines that can no longer be met.",
        "limits": "Cost of delay is your estimate; the order is only as good as those figures.",
        "spec": {
          "kind": "schema",
          "fields": [
            {
              "key": "asOf",
              "label": "As of (defaults to today)",
              "type": "date"
            }
          ],
          "tables": [
            {
              "key": "items",
              "label": "Pending decisions or work",
              "minRows": 1,
              "columns": [
                {
                  "key": "item",
                  "label": "Item",
                  "type": "text",
                  "required": true
                },
                {
                  "key": "costPerWeek",
                  "label": "Cost of delay per week",
                  "type": "number",
                  "required": true,
                  "min": 0
                },
                {
                  "key": "weeks",
                  "label": "Weeks to carry out once decided",
                  "type": "number",
                  "required": true,
                  "min": 0.1
                },
                {
                  "key": "deadline",
                  "label": "Hard deadline (if any)",
                  "type": "date"
                }
              ]
            }
          ]
        }
      }
    ]
  },
  {
    "id": "team-development",
