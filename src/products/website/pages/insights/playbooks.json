                  "min": 0,
                  "required": true
                }
              ]
            }
          ]
        }
      },
      {
        "id": "T48",
        "code": "A25",
        "name": "Next-Role Readiness",
        "purpose": "Measures how ready a person is for a target role and how long the gaps take to close.",
        "computes": "How far a person meets a target role’s requirements and how long the gaps take to close.",
        "limits": "Levels and timings are your assessment.",
        "spec": {
          "kind": "schema",
          "fields": [
            {
              "key": "person",
              "label": "Person",
              "type": "text",
              "required": true
            },
            {
              "key": "targetRole",
              "label": "Target role",
              "type": "text",
              "required": true
            }
          ],
          "tables": [
            {
              "key": "requirements",
              "label": "Target role requirements",
              "minRows": 1,
              "columns": [
                {
                  "key": "requirement",
                  "label": "Requirement",
                  "type": "text",
                  "required": true
                },
                {
                  "key": "required",
                  "label": "Level required (1–5)",
                  "type": "integer",
                  "min": 1,
                  "max": 5,
                  "required": true
                },
                {
                  "key": "current",
                  "label": "Current level (1–5)",
                  "type": "integer",
                  "min": 1,
                  "max": 5,
                  "required": true
                },
                {
                  "key": "weeks",
                  "label": "Weeks to close the gap",
                  "type": "number",
                  "min": 0
                }
              ]
            }
          ]
        }
      }
    ]
  },
  {
    "id": "delivery-health",
    "category": "Consistency",
    "title": "Review delivery without chasing noise",
    "description": "Read delivery flow, then check whether a metric is showing real change.",
    "tools": [
      {
        "id": "T06",
        "code": "R02",
        "name": "Delivery Flow Metrics",
        "purpose": "Measures how fast and how predictably work flows: throughput, cycle time, work in progress and flow efficiency.",
        "computes": "Throughput, cycle time, work in progress, predictability and flow efficiency, with a Little’s Law consistency check.",
        "limits": "Reads only the period figures you enter; it is not connected to your task tools.",
        "spec": {
          "kind": "schema",
          "fields": [
            {
              "key": "periodDays",
              "label": "Days in each period",
              "type": "integer",
              "min": 1,
              "default": 7
            }
          ],
          "tables": [
            {
              "key": "periods",
              "label": "Periods",
              "hint": "one row per week or sprint, oldest first",
              "minRows": 3,
              "columns": [
                {
                  "key": "label",
                  "label": "Period",
                  "type": "text",
                  "required": true
                },
                {
                  "key": "throughput",
                  "label": "Items finished",
                  "type": "number",
                  "required": true,
                  "min": 0
                },
                {
                  "key": "cycleTimeDays",
                  "label": "Average cycle time (days)",
                  "type": "number",
                  "required": true,
                  "min": 0
                },
                {
                  "key": "wip",
                  "label": "Average work in progress",
                  "type": "number",
                  "required": true,
                  "min": 0
                },
                {
                  "key": "activeDays",
                  "label": "Average days actively worked per item",
                  "type": "number",
                  "min": 0
                }
              ]
            }
          ]
        }
      },
      {
        "id": "T07",
        "code": "R03",
        "name": "Drift & Stability Monitor",
        "purpose": "Tells real drift from routine variation in any metric, so you react to signals and not to noise.",
        "computes": "Natural process limits for any metric and the standard control-chart rules that separate real drift from routine variation.",
        "limits": "Reads only the values you enter; it detects that something changed, not why.",
        "spec": {
          "kind": "schema",
          "fields": [
            {
              "key": "metric",
              "label": "Metric",
              "type": "text",
              "required": true
            },
            {
              "key": "betterWhen",
              "label": "Better when",
              "type": "select",
              "options": [
                {
                  "value": "higher",
                  "label": "higher"
                },
                {
                  "value": "lower",
                  "label": "lower"
                },
                {
                  "value": "closer to target",
                  "label": "closer to target"
                }
              ],
              "default": "higher"
            },
            {
              "key": "target",
              "label": "Target (optional)",
              "type": "number"
            }
          ],
          "tables": [
            {
              "key": "values",
              "label": "Values",
              "hint": "at least 8 points, oldest first",
              "minRows": 8,
              "columns": [
                {
                  "key": "label",
                  "label": "Period",
                  "type": "text"
                },
                {
                  "key": "value",
                  "label": "Value",
                  "type": "number",
                  "required": true
                }
              ]
            }
          ]
        }
      }
    ]
  },
