  {
    "id": "growth-review",
    "category": "Growth",
    "title": "Choose opportunities and review value",
    "description": "Score opportunities, then compare planned benefits with realised value.",
    "tools": [
      {
        "id": "T51",
        "code": "Z01",
        "name": "Growth Opportunity Scoring",
        "purpose": "Ranks growth opportunities and shows how effort is spread across the three horizons.",
        "computes": "RICE score (reach × impact × confidence ÷ effort) for each opportunity and the effort mix across the three horizons.",
        "limits": "All inputs are your estimates; it does not research markets.",
        "spec": {
          "kind": "schema",
          "fields": [],
          "tables": [
            {
              "key": "opportunities",
              "label": "Opportunities",
              "minRows": 1,
              "columns": [
                {
                  "key": "opportunity",
                  "label": "Opportunity",
                  "type": "text",
                  "required": true
                },
                {
                  "key": "horizon",
                  "label": "Horizon",
                  "type": "select",
                  "options": [
                    {
                      "value": "H1 — extend the core",
                      "label": "H1 — extend the core"
                    },
                    {
                      "value": "H2 — build emerging business",
                      "label": "H2 — build emerging business"
                    },
                    {
                      "value": "H3 — create future options",
                      "label": "H3 — create future options"
                    }
                  ],
                  "required": true
                },
                {
                  "key": "ansoff",
                  "label": "Ansoff move",
                  "type": "select",
                  "options": [
                    {
                      "value": "market penetration",
                      "label": "market penetration"
                    },
                    {
                      "value": "product development",
                      "label": "product development"
                    },
                    {
                      "value": "market development",
                      "label": "market development"
                    },
                    {
                      "value": "diversification",
                      "label": "diversification"
                    }
                  ],
                  "required": true
                },
                {
                  "key": "reach",
                  "label": "Customers or users reached per year",
                  "type": "number",
                  "required": true,
                  "min": 0
                },
                {
                  "key": "impact",
                  "label": "Impact on each",
                  "type": "select",
                  "options": [
                    {
                      "value": 0.25,
                      "label": "Minimal (0.25)"
                    },
                    {
                      "value": 0.5,
                      "label": "Low (0.5)"
                    },
                    {
                      "value": 1,
                      "label": "Medium (1)"
                    },
                    {
                      "value": 2,
                      "label": "High (2)"
                    },
                    {
                      "value": 3,
                      "label": "Massive (3)"
                    }
                  ],
                  "required": true
                },
                {
                  "key": "confidence",
                  "label": "Confidence in these estimates (%)",
                  "type": "percent",
                  "required": true
                },
                {
                  "key": "effort",
                  "label": "Effort (person-months)",
                  "type": "number",
                  "required": true,
                  "min": 0.1
                }
              ]
            }
          ]
        }
      },
      {
        "id": "T30",
        "code": "Q58",
        "name": "Benefits & After-Action Review",
        "purpose": "Compares planned with realised value and records what was learned.",
        "computes": "Planned against realised value per item and overall, with the lessons recorded.",
        "limits": "Values are what you report; attributing results to one decision is your judgement.",
        "spec": {
          "kind": "schema",
          "fields": [],
          "tables": [
            {
              "key": "items",
              "label": "Decisions or initiatives reviewed",
              "minRows": 1,
              "columns": [
                {
                  "key": "item",
                  "label": "Decision or initiative",
                  "type": "text",
                  "required": true
                },
                {
                  "key": "benefit",
                  "label": "Benefit claimed",
                  "type": "text",
                  "required": true
                },
                {
                  "key": "planned",
