{
  "name": "lamid-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs --production",
    "errors:daily": "node scripts/error-report.mjs",
    "test": "node --test --test-concurrency=3 tests/*.test.mjs",
    "test:e2e": "npm run build && node tests/demo-browser.mjs && node tests/public-browser.mjs",
    "test:demo": "npm run test:demo-browser",
    "test:audit-engines": "node tests/deep-engine-audit.mjs && node tests/tool-catalog.test.mjs && node tests/engine-reference.test.mjs",
    "test:audit-demo": "npm run build && node tests/deep-demo-browser.mjs",
    "test:public-browser": "npm run build && node tests/public-browser.mjs",
    "release:check": "node scripts/release-check.mjs",
    "deployment:check": "node scripts/check-deployment.mjs --config",
    "deployment:smoke": "node scripts/check-deployment.mjs --live",
    "test:demo-access": "node --test --test-concurrency=1 tests/demo-access.test.mjs tests/demo-conversion.test.mjs",
    "test:demo-browser": "npm run build && node tests/demo-browser.mjs",
    "test:demo-tools": "node tests/demo-tools.test.mjs",
    "check": "npm run build && npm test",
    "test:exploratory": "npm run test:audit-demo",
    "test:full": "npm run release:check",
    "prune-test-schemas": "node scripts/prune-test-schemas.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:generate": "node scripts/generate-content.mjs",
    "docs:products": "node scripts/update-product-index.mjs",
    "seo:sitemap": "node scripts/generate-sitemap.mjs",
    "content:catalog": "node scripts/sync-page-catalog.mjs && node scripts/generate-sitemap.mjs && prettier --write src/content/catalog.ts src/content/documentPages.ts"
  },
  "overrides": {
    "hyperid": {
      "uuid": "^11.1.1"
    }
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/instrument-serif": "^5.2.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "motion": "13.2.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "svix": "^2.8.0",
    "three": "0.185.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "^4.5.0",
    "autocannon": "^8.0.0",
    "prettier": "3.9.6",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  }
}
